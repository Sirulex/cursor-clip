#!/bin/sh
set -eu

# Without --socket=wayland Flatpak removes WAYLAND_DISPLAY. The manifest
# exposes the host compositor sockets directly, so select the available one
# again from inside the sandbox.
if [ -z "${WAYLAND_SOCKET:-}" ]; then
    selected_wayland_display=""

    for candidate in wayland-0 wayland-1; do
        if [ -S "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/${candidate}" ]; then
            selected_wayland_display="${candidate}"
            break
        fi
    done

    if [ -z "${selected_wayland_display}" ]; then
        echo "cursor-clip: no exposed Wayland compositor socket found" >&2
        exit 1
    fi

    export WAYLAND_DISPLAY="${selected_wayland_display}"
fi

runtime_dir="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/cursor-clip"
socket_path="${runtime_dir}/cursor-clip.sock"
lock_path="${runtime_dir}/daemon.lock"
mkdir -p "${runtime_dir}"

exec 9>"${lock_path}"

if [ "${1:-}" = "--daemon" ]; then
    if flock -n 9; then
        exec cursor-clip "$@"
    fi
    exit 0
fi

if flock -n 9; then
    cursor-clip --daemon &
    exec 9>&-
fi

# A second launcher can arrive while the first daemon is still initializing.
attempt=0
while [ ! -S "${socket_path}" ] && [ "${attempt}" -lt 100 ]; do
    sleep 0.05
    attempt=$((attempt + 1))
done

exec cursor-clip "$@"
